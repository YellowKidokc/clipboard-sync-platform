# For running the server directly (npm run dev / npm start).
# For the Docker stack use infra/.env.example instead.

PORT=5000
DATABASE_URL=postgresql://user:pass@NAS_IP:5432/clipsync

# Required — the server refuses to start without it. Must be at least 32
# characters and not a placeholder like "change-me".
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional. Without a key the AI routes return a stub string.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

BLOB_STORAGE_PATH=./blobs

# Optional. Comma-separated browser origins allowed to call this API.
# Leave empty in production: the server ships the PWA on its own origin, so no
# CORS headers are needed. Set this only when running the Vite dev server:
# CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=

# Optional. Comma-separated hostnames that webhook rules may target even though
# they resolve to a private address. Everything else is blocked from reaching
# localhost, RFC1918 space and cloud metadata endpoints.
# Example: WEBHOOK_ALLOWED_HOSTS=nas.local,192.168.1.177
WEBHOOK_ALLOWED_HOSTS=
