# Copy to infra/.env and fill in. The stack will not start without the two
# required values — that is deliberate, not a bug.

# Required. Generate with: openssl rand -hex 32
# Keep it hex/alphanumeric. Must be at least 32 characters; placeholders like
# "change-me" are rejected by server/src/config.ts and will crash-loop the
# container.
JWT_SECRET=

# Required. Use alphanumeric only — this value is interpolated into a
# postgres:// URL, so @ : / ? # will corrupt the connection string.
POSTGRES_PASSWORD=

# Optional overrides
POSTGRES_DB=clipsync
POSTGRES_USER=clipsync

# Host port. Do NOT use 5000 on a Synology: that is DSM's own web UI.
CLIPSYNC_PORT=5055

# Optional. Without a key the AI routes return a stub string instead of
# calling OpenAI, and predictions fall back to a placeholder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Comma-separated browser origins allowed to call the API. Leave
# empty: the container serves the web UI from the same origin as the API, so
# no CORS headers are needed.
CORS_ORIGIN=

# Optional. Comma-separated hostnames that webhook rules may target even though
# they resolve to a private address. Needed to POST to something on your LAN,
# e.g. an n8n instance on the NAS:
# WEBHOOK_ALLOWED_HOSTS=192.168.1.177
WEBHOOK_ALLOWED_HOSTS=
