# Copy to infra/.env and fill in. The stack will not start without the two
# required values — that is deliberate, not a bug.

# Required. Generate with: openssl rand -hex 32
# Keep it hex/alphanumeric. The old "change-me" placeholder is rejected by
# server/src/config.ts and will crash-loop the container.
JWT_SECRET=

# Required. Use alphanumeric only — this value is interpolated into a
# postgres:// URL, so @ : / ? # will corrupt the connection string.
POSTGRES_PASSWORD=

# Optional overrides
POSTGRES_DB=clipsync
POSTGRES_USER=clipsync

# Host port. Do NOT use 5000 on a Synology: that is DSM's own web UI.
CLIPSYNC_PORT=5055

# Optional. Without a key the AI routes return a stub string instead of
# calling OpenAI, and predictions fall back to a placeholder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
